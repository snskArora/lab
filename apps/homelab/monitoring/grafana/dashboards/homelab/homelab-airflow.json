{
  "uid": "homelab-airflow",
  "title": "Homelab / Airflow",
  "description": "Airflow 3 on LocalExecutor: scheduler and DAG processor health, DAG runs and tasks, pod resources and logs. Metrics come from the statsd exporter.",
  "tags": [
    "homelab"
  ],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 41,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "homelab"
      ],
      "asDropdown": true,
      "title": "Homelab boards",
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
