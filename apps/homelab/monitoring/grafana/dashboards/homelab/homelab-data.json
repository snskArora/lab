        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (datname) (rate(cnpg_pg_stat_database_xact_commit{datname!~\"template.*\"}[$__rate_interval])) + sum by (datname) (rate(cnpg_pg_stat_database_xact_rollback{datname!~\"template.*\"}[$__rate_interval]))",
          "legendFormat": "{{datname}}",
          "range": true,
          "instant": false
