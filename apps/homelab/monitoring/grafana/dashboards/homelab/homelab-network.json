        }
      },
      "id": 15
    },
    {
      "type": "timeseries",
      "title": "Tunnel request errors",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 15,
        "y": 35,
        "w": 9,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pod) (rate(cloudflared_tunnel_request_errors[$__rate_interval]))",
