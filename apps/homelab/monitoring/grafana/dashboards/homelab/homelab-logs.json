    {
      "type": "timeseries",
      "title": "Error-looking pod lines per namespace",
      "description": "Heuristic: a level field of error/fatal/panic, klog E-lines, or the words error/fatal/panic in the message.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "kubernetes.namespace_name:* (level:~\"(?i)^(error|err|fatal|panic|crit|critical|e)$\" or _msg:~\"(?i)\\\\b(error|fatal|panic)\\\\b\" or _msg:~\"^E\\\\d{4} \") | stats by (kubernetes.namespace_name) count() errors",
          "queryType": "statsRange",
          "legendFormat": "{{kubernetes.namespace_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 70,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 17
    },
    {
      "type": "logs",
      "title": "Recent error-looking pod lines",
      "description": "",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
