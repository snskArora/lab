    {
      "type": "timeseries",
      "title": "Fluent Bit retries and errors",
      "description": "Retries happen while VictoriaLogs restarts; errors that keep growing need a look.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
